{
  "name": "@santoshyadavdev/ng-devtools",
  "version": "0.0.2",
  "description": "Angular DevTools \u2014 inspect components, signals, DI, and routes. Runs standalone, embedded, or over MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santoshyadavdev/angular-devtools.git",
    "directory": "packages/ng-devtools"
  },
  "homepage": "https://github.com/santoshyadavdev/angular-devtools#readme",
  "type": "module",
  "bin": {
    "ng-devtools": "./bin.mjs"
  },
  "exports": {
    ".": "./src/devframe.ts",
    "./devframe": "./src/devframe.ts",
    "./overlay": "./src/overlay.ts",
    "./popup": "./src/popup.ts",
    "./http": "./src/http.ts",
    "./package.json": "./package.json",
    "./vite": "./src/vite.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/devframe.mjs",
      "./devframe": "./dist/devframe.mjs",
      "./overlay": "./dist/overlay.mjs",
      "./popup": "./dist/popup.mjs",
      "./http": "./dist/http.mjs",
      "./package.json": "./package.json",
      "./vite": "./dist/vite.mjs"
    }
  },
  "scripts": {
    "build": "tsdown && vite build --config ../../app/vite.config.ts --outDir ../packages/ng-devtools/dist/public --emptyOutDir",
    "prepack": "pnpm build"
  },
  "files": [
    "dist",
    "bin.mjs"
  ],
  "keywords": [
    "angular",
    "devtools",
    "devframe",
    "signals",
    "dependency-injection",
    "mcp"
  ],
  "dependencies": {
    "@devframes/agentic": "^1.1.0",
    "@valibot/to-json-schema": "^1.8.0",
    "cac": "^7.0.0",
    "devframe": "^1.1.0",
    "h3": "^1.15.11",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@angular/common": ">=20",
    "@angular/core": ">=20",
    "rxjs": ">=7"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.1.0",
    "@angular/core": "^22.1.0",
    "rxjs": "~7.8.0",
    "tsdown": "^0.23.0"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
