{
  "name": "@pangular-inspector/devtools",
  "version": "0.0.7",
  "description": "Pangular Inspector, the unified Angular devtools. Inspect components, signals, DI, and routes. Runs standalone, embedded, or over MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pangular-inspector/devtools.git",
    "directory": "packages/devtools"
  },
  "homepage": "https://pangular-inspector.dev",
  "bugs": {
    "url": "https://github.com/pangular-inspector/devtools/issues"
  },
  "type": "module",
  "bin": {
    "pangular": "./bin.mjs"
  },
  "exports": {
    ".": "./src/devframe.ts",
    "./devframe": "./src/devframe.ts",
    "./config": "./src/config.ts",
    "./cd-data": "./src/cd-data.ts",
    "./overlay": "./src/overlay-auto.ts",
    "./overlay-manual": "./src/overlay.ts",
    "./capacitor-hook": "./src/capacitor-hook.ts",
    "./overlay-angular-native": "./src/overlay-angular-native.ts",
    "./popup": "./src/popup.ts",
    "./overlay-nativescript": "./src/overlay-nativescript.ts",
    "./cli": "./src/cli.ts",
    "./http": "./src/http.ts",
    "./hub": "./src/hub.ts",
    "./package.json": "./package.json",
    "./vite": "./src/vite.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/devframe.mjs",
      "./devframe": "./dist/devframe.mjs",
      "./config": "./dist/config.mjs",
      "./cd-data": "./dist/cd-data.mjs",
      "./overlay": "./dist/overlay.mjs",
      "./overlay-manual": "./dist/overlay-manual.mjs",
      "./capacitor-hook": "./dist/capacitor-hook.mjs",
      "./overlay-angular-native": "./dist/overlay-angular-native.mjs",
      "./popup": "./dist/popup.mjs",
      "./overlay-nativescript": "./dist/overlay-nativescript.mjs",
      "./cli": "./dist/cli.mjs",
      "./http": "./dist/http.mjs",
      "./hub": "./dist/hub.mjs",
      "./package.json": "./package.json",
      "./vite": "./dist/vite.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "devframe": [
        "./dist/devframe.d.mts"
      ],
      "config": [
        "./dist/config.d.mts"
      ],
      "cd-data": [
        "./dist/cd-data.d.mts"
      ],
      "overlay": [
        "./dist/overlay.d.mts"
      ],
      "overlay-manual": [
        "./dist/overlay-manual.d.mts"
      ],
      "capacitor-hook": [
        "./dist/capacitor-hook.d.mts"
      ],
      "overlay-angular-native": [
        "./dist/overlay-angular-native.d.mts"
      ],
      "popup": [
        "./dist/popup.d.mts"
      ],
      "overlay-nativescript": [
        "./dist/overlay-nativescript.d.mts"
      ],
      "cli": [
        "./dist/cli.d.mts"
      ],
      "http": [
        "./dist/http.d.mts"
      ],
      "hub": [
        "./dist/hub.d.mts"
      ],
      "vite": [
        "./dist/vite.d.mts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && vite build --config ../../app/vite.config.ts --outDir ../packages/devtools/dist/public --emptyOutDir",
    "prepack": "pnpm build"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/app/**/*"
        ]
      }
    }
  },
  "files": [
    "dist",
    "skills",
    "bin.mjs"
  ],
  "keywords": [
    "angular",
    "devtools",
    "devframe",
    "signals",
    "dependency-injection",
    "mcp",
    "nativescript"
  ],
  "dependencies": {
    "@devframes/agentic": "^1.2.3",
    "@devframes/hub": "^1.2.3",
    "@devframes/hub-ui": "^1.2.3",
    "@devframes/plugin-messages": "^1.2.3",
    "@devframes/plugin-messages--assets": "^1.2.3",
    "@devframes/plugin-terminals": "^1.2.3",
    "@devframes/plugin-terminals--assets": "^1.2.3",
    "@valibot/to-json-schema": "^1.8.0",
    "axe-core": "^4.13.0",
    "cac": "^7.0.0",
    "devframe": "^1.2.3",
    "h3": "^1.15.11",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@nativescript/core": ">=8",
    "@angular/common": ">=12.2",
    "@angular/core": ">=12.2",
    "rxjs": ">=7",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "@nativescript/core": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@capacitor/core": "^8.5.3",
    "hono": "4.13.8",
    "@nativescript/core": "^9.1.0",
    "rxjs": "~7.8.0",
    "tsdown": "^0.23.0"
  },
  "engines": {
    "node": ">=22"
  }
}
