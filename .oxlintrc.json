{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.angular/**",
    "**/node_modules/**",
    "extension/ui/**",
    "examples/nativescript/platforms/**",
    "examples/nativescript/hooks/**"
  ]
}
