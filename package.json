{
  "name": "angular-devtools",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "ng-devtools": "bin.mjs"
  },
  "scripts": {
    "ng": "ng",
    "start": "pnpm devtools:build-pkg && nx serve",
    "build": "nx build",
    "watch": "nx build --watch --configuration development",
    "test": "nx test",
    "test:devtools": "vitest run --root packages/ng-devtools",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p app/tsconfig.json --noEmit && tsc -p packages/ng-devtools",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve:ssr:angular-devtools": "node dist/angular-devtools/server/server.mjs",
    "devtools:dev": "vite --config app/vite.config.ts",
    "devtools:build": "vite build --config app/vite.config.ts",
    "devtools:standalone": "node bin.mjs dev",
    "devtools:mcp": "node bin.mjs mcp",
    "devtools:report": "node bin.mjs build --outDir dist-report",
    "devtools:build-pkg": "pnpm --filter @santoshyadavdev/ng-devtools build",
    "devtools:publish": "pnpm --filter @santoshyadavdev/ng-devtools publish --access public",
    "extension:build": "pnpm devtools:build && rm -rf extension/ui && cp -r dist/devtools-ui extension/ui",
    "extension:zip": "pnpm extension:build && rm -f dist/ng-devtools-extension.zip && cd extension && zip -r ../dist/ng-devtools-extension.zip . -x '*.DS_Store'",
    "analog:dev": "pnpm --filter analog-demo dev"
  },
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "@ngrx/signals": "^22.0.1",
    "@santoshyadavdev/ng-devtools": "workspace:*",
    "devframe": "^1.1.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@angular-devkit/core": "^22.1.8",
    "@angular-devkit/schematics": "^22.1.8",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@devframes/agentic": "^1.1.0",
    "@devframes/vite": "^1.0.0",
    "@nx/angular": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@schematics/angular": "^22.1.8",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "jsdom": "^28.0.0",
    "nx": "23.2.1",
    "prettier": "^3.8.1",
    "sass": "^1.105.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.8"
  }
}
