{
  "name": "pangular-inspector",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "pangular": "bin.mjs"
  },
  "scripts": {
    "ng": "ng",
    "prepare": "(git config core.hooksPath >/dev/null || git config core.hooksPath .githooks) && (git config commit.template >/dev/null || git config commit.template .gitmessage) || true",
    "commit:check": "node scripts/commit-message.mjs --branch",
    "skills:check": "node scripts/validate-skills.mjs",
    "start": "pnpm devtools:build-pkg && nx serve",
    "build": "nx build",
    "watch": "nx build --watch --configuration development",
    "test": "nx test",
    "test:devtools": "vitest run --root packages/devtools",
    "test:panel": "vitest run --config app/vitest.config.ts",
    "test:axe": "pnpm devtools:build-pkg && node bin.mjs build --outDir dist/panel-axe && node scripts/panel-axe.mjs dist/panel-axe",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && ngc -p app/tsconfig.json --noEmit && ngc -p examples/analog/tsconfig.app.json --noEmit && tsc -p packages/devtools",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve:ssr:pangular-inspector": "node dist/pangular-inspector/server/server.mjs",
    "devtools:dev": "vite --config app/vite.config.ts",
    "devtools:build": "vite build --config app/vite.config.ts",
    "devtools:standalone": "node bin.mjs dev",
    "devtools:mcp": "node bin.mjs mcp",
    "devtools:report": "node bin.mjs build --outDir dist-report",
    "devtools:nativescript": "cd examples/nativescript && node ../../bin.mjs dev --no-auth",
    "devtools:nativescript:device": "cd examples/nativescript && node ../../bin.mjs dev --host 0.0.0.0 --no-auth",
    "devtools:build-pkg": "pnpm --filter @pangular-inspector/devtools build",
    "devtools:publish": "pnpm --filter @pangular-inspector/devtools publish --access public",
    "verify:publish": "node scripts/verify-publish.mjs",
    "extension:build": "pnpm devtools:build && rm -rf extension/ui && cp -r dist/devtools-ui extension/ui",
    "extension:zip": "pnpm extension:build && node scripts/extension-zip.mjs",
    "analog:dev": "pnpm --filter analog-demo dev",
    "docs:dev": "nx serve pangular-inspector-docs",
    "docs:build": "nx build pangular-inspector-docs",
    "docs:test": "nx test pangular-inspector-docs",
    "docs:deploy": "nx deploy pangular-inspector-docs"
  },
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "@ngrx/signals": "^22.0.1",
    "@pangular-inspector/devtools": "workspace:*",
    "devframe": "^1.2.2",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@angular-devkit/core": "^22.1.8",
    "@angular-devkit/schematics": "^22.1.8",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@devframes/agentic": "^1.2.2",
    "@devframes/vite": "^1.2.2",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "@nx/angular": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@schematics/angular": "^22.1.8",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "jsdom": "^28.0.0",
    "nx": "23.2.1",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "sass": "^1.105.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.8"
  }
}
